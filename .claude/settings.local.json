{
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run electron:build:*)",
      "Bash(npx electron-builder:*)",
      "Bash(set CSC_IDENTITY_AUTO_DISCOVERY=false)",
      "Bash(set:*)",
      "Bash(npx electron:*)",
      "Bash(node_modules\\\\.bin\\\\electron:*)",
      "Bash(npm run electron:*)",
      "Bash(npm ls:*)",
      "Bash(npm rebuild:*)",
      "Bash(tasklist:*)",
      "Bash(npx tsc *)",
      "Bash(npx --no-install playwright --version)",
      "Bash(tee /tmp/vite-dev.log)",
      "Read(//tmp/**)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:5173/)",
      "Bash(netstat -ano)",
      "Bash(powershell -Command \"Start-Process 'http://localhost:5173/'\")",
      "Bash(powershell -Command \"Stop-Process -Id 21564 -Force\")"
    ]
  }
}
